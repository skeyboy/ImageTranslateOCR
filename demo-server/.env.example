SERVER_ADDR=0.0.0.0:8090
DATABASE_URL=demo-server.sqlite3
# Startup default. The Admin page can switch new requests between qwen and openlux at runtime.
TRANSLATION_PROVIDER=openlux
# Local Ollama OpenAI-compatible endpoint. No online API key is needed.
QWEN_BASE_URL=http://127.0.0.1:11434/v1
QWEN_API_KEY=
QWEN_MODEL=qwen3.5-translation:9b
# Comma-separated allowlist exposed in Admin and accepted by X-Translation-Model.
QWEN_MODELS=qwen3.5-translation:9b
QWEN_REASONING_EFFORT=none
QWEN_MAX_TOKENS=4096
QWEN_TIMEOUT_SECONDS=210
# OpenLux OpenAI-compatible endpoint. OPENLUX_MODEL must be a model ID enabled for the API key.
OPENLUX_BASE_URL=https://api.openlux.ai/v1
OPENLUX_API_KEY=
OPENLUX_MODEL=gemini-3.5-flash-lite
OPENLUX_MODELS=gemini-3.5-flash-lite,gpt-4.1,claude-sonnet-4-6
OPENLUX_REASONING_EFFORT=none
OPENLUX_MAX_TOKENS=4096
OPENLUX_TIMEOUT_SECONDS=210
SELF_HOSTED_BEARER_TOKEN=
REQUEST_HISTORY_LIMIT=200
REQUEST_IMAGE_DIR=request-images
RUST_LOG=image_translate_demo_server=info,tower_http=info
